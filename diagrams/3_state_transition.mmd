stateDiagram-v2
    [*] --> 程序启动: Unity游戏启动

    程序启动 --> 主菜单: InitializeAsync()\nUGS认证完成

    state 主菜单 {
        [*] --> Idle
        Idle --> LocalGame: 点击 Local Game
        Idle --> AIGame: 点击 vs AI
        Idle --> OnlineGame: 点击 Online Game
        Idle --> Leaderboard: 点击 Leaderboard
        Leaderboard --> Idle: 关闭排行榜
    }

    主菜单 --> 本地双人对战: StartLocalGame()\n_localBoard = new ChessBoard()
    主菜单 --> 人机对战: StartRobotGameWithDifficulty(depth)\n难度选择(depth=1/3/4/5)
    主菜单 --> 在线对战等待: CreateGame()\nCloudCode.HostGame()

    state 本地双人对战 {
        [*] --> WhiteTurn_L
        WhiteTurn_L --> BlackTurn_L: MakeLocalMove()\n_localWhiteTurn = false\nSetPovLocal()
        BlackTurn_L --> WhiteTurn_L: MakeLocalMove()\n_localWhiteTurn = true\nSetPovLocal()
        WhiteTurn_L --> GameOver_L: IsEndGame == true
        BlackTurn_L --> GameOver_L: IsEndGame == true
    }

    state 人机对战 {
        [*] --> PlayerTurn
        PlayerTurn --> AIThinking: MakeLocalMove()\n_aiThinking = true
        AIThinking --> DoRobotMove: DoRobotMoveAsync()
        DoRobotMove --> PlayerTurn: AI走棋完成\n_aiThinking = false
        PlayerTurn --> GameOver_AI: IsEndGame == true
        AIThinking --> GameOver_AI: IsEndGame == true
    }

    state 在线对战等待 {
        [*] --> Waiting: 显示房间码\n等待对手加入
        Waiting --> 在线对战中: Push: opponentJoined\nOnGameStart(FEN)\n随机分配黑白方
    }

    state 在线对战中 {
        [*] --> MyTurn
        MyTurn --> OpponentTurn: MakeMove()\nCloudCode.MakeMove()\nPush boardUpdated
        OpponentTurn --> MyTurn: OnBoardUpdate(FEN)\nPush boardUpdated
        MyTurn --> GameOver_OL: boardUpdate.GameOver==true
        OpponentTurn --> GameOver_OL: boardUpdate.GameOver==true
        MyTurn --> Resigning: Resign()
    }

    state Resigning {
        [*] --> CloudResign: CloudCode.Resign(session)\nchessBoard.Resign(color)\nPush boardUpdated
        CloudResign --> GameOver_OL: GameOver==true
    }

    本地双人对战 --> 游戏结束: ShowGameOver()
    人机对战 --> 游戏结束: ShowGameOver()
    在线对战中 --> 游戏结束: ShowGameOver()
    Resigning --> 游戏结束: ShowGameOver()

    state 游戏结束 {
        [*] --> ShowResult: ShowGameOver(resultMessage)\n禁用Resign/Undo按钮
        ShowResult --> Animation: PlayGameEndAnimation()\n胜利/失败/和棋动画
        Animation --> SubmitScore: SubmitGameScore()\nCalculateScore()\nLeaderboardAPI.SubmitScore()
        SubmitScore --> ReturnMenu: 返回主菜单
    }

    游戏结束 --> 主菜单: mainMenuUI.ShowWithResult()

    note right of 人机对战
        AI走棋流程:
        depth=1/3: ChessAI.Minimax()
        本地Alpha-Beta搜索

        depth=4: ClaudeApiProvider
        thinking:disabled

        depth=5: ClaudeApiProvider
        thinking:enabled(6K tokens)
    end note

    note right of 在线对战等待
        在线架构:
        UGS Lobby (房间管理)
        UGS Cloud Save (FEN存储)
        UGS Push (消息推送)
        Cloud Code C# (走法验证)
    end note
