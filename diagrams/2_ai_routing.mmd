    style CLOUD fill:#bbdefb,stroke:#1976d2
    style MINMAX fill:#e8f5e9,stroke:#81c784
    style LOCAL_EVAL fill:#e8f5e9,stroke:#81c784
    style LOCAL_RESULT fill:#e8f5e9,stroke:#66bb6a
    style THINKING_DECISION fill:#fff9c4,stroke:#f9a825
    style NO_THINK fill:#e3f2fd,stroke:#64b5f6
    style THINK fill:#e8eaf6,stroke:#5c6bc0
    style API_CALL fill:#f5f5f5,stroke:#9e9e9e
    style PARSE fill:#fff3e0,stroke:#ff9800
    style FALLBACK fill:#ffcdd2,stroke:#ef5350
    style RETRY fill:#ffe0b2,stroke:#ffb74d
