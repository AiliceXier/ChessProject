graph TB
    START["<b>AI 走棋请求</b><br/>玩家走棋后触发<br/>Robot模式白方走完后"]

    START --> CHECK{"<b>AI 难度判断</b><br/>depth <= 3? or depth >= 4?"}

    CHECK -->|"<b>depth ≤ 3</b><br/>Easy(depth=1)<br/>Medium(depth=3)"| LOCAL["<b>本地 MinMax 引擎</b><br/>ChessAI.cs<br/>new ChessAI(maxDepth=depth)"]

    CHECK -->|"<b>depth ≥ 4</b><br/>Hard(depth=4)<br/>Master(depth=5)"| CLOUD["<b>云端 Claude API</b><br/>ClaudeApiProvider.cs<br/>Volces Ark 网关"]

    LOCAL --> MINMAX["<b>MinMax + Alpha-Beta 剪枝</b><br/>GenerateMovesSync遍历8×8<br/>递归搜索至指定深度<br/>Evaluate: Piece-Square Table"]

    MINMAX --> LOCAL_EVAL["<b>局面评估函数</b><br/>Pawn=100 Knight=320 Bishop=330<br/>Rook=500 Queen=900 King=20000<br/>+ 6种棋子位置价值表(8×8)"]

    LOCAL_EVAL --> LOCAL_RESULT["<b>depth=1 (Easy)</b>: ~30节点, <1s<br/><b>depth=3 (Medium)</b>: ~8000节点, 3~5s<br/>完全离线 · 结果确定 · 速度快"]

    CLOUD --> THINKING_DECISION{"<b>thinking 模式?</b>"}

    THINKING_DECISION -->|"depth=4<br/>max_tokens=64<br/>thinking: disabled"| NO_THINK["<b>Hard 模式</b><br/>无思考链<br/>直接输出UCI走法"]

    THINKING_DECISION -->|"depth=5<br/>max_tokens=8192<br/>thinking budget=6000"| THINK["<b>Master 模式</b><br/>有思考链(6K tokens)<br/>深度推理后输出走法"]

    NO_THINK --> API_CALL
    THINK --> API_CALL

    API_CALL["<b>Volces Ark API 调用</b><br/>POST /api/coding/v1/messages<br/>model=ark-code-latest→MiniMax-M3<br/>System: You are a strong chess engine..."]

    API_CALL --> PARSE["<b>响应解析流程</b><br/>1. ExtractTextBlock 提取text块<br/>2. 若空则fallback到ExtractThinkingBlock<br/>3. ExtractUci 正则提取UCI格式<br/>4. 若UCI失败→FindMoveBySan尝试SAN<br/>5. 若SAN也失败→FindLegalMove枚举匹配"]

    PARSE --> VALID{"<b>走法合法性校验</b><br/>从from位置获取legal moves<br/>匹配to位置找到对应Move对象"}

    VALID -->|"合法"| SUCCESS["<b>返回最佳走法</b><br/>DoRobotMoveAsync执行走棋<br/>日志: [AI move: e2e4 (depth=5, eval=+0.3)]"]

    VALID -->|"不合法"| RETRY{"<b>是否首次尝试?</b>"}

    RETRY -->|"是, 换constrained prompt"| RETRY_CALL["<b>二次尝试（约束模式）</b><br/>BuildUserPromptWithLegalList<br/>明确列出所有合法SAN走法<br/>要求模型从中选择一个"]

    RETRY_CALL --> PARSE

    RETRY -->|"否或API失败"| FALLBACK["<b>Fallback: 随机合法走法</b><br/>PickRandomLegalMove()<br/>board.Moves()[Random.Range]<br/>日志: Using random legal move"]

    LOCAL_RESULT --> MERGE
    SUCCESS --> MERGE
    FALLBACK --> MERGE

    MERGE["<b>走法执行</b><br/>_localBoard.Move(aiMove)<br/>SyncBoard(newFEN)<br/>Update UI + MoveHistory"]

    style START fill:#2c3e50,color:#fff,stroke:#1a252f
    style MERGE fill:#2c3e50,color:#fff,stroke:#1a252f
