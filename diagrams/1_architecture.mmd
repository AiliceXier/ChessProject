        Player["<b>Player.cs</b><br/>游戏主控 · 用户输入<br/>AI走棋调度 · 在线对战管理<br/>1607行"]
        ChessAI_cs["<b>ChessAI.cs</b><br/>MinMax搜索 + Alpha-Beta剪枝<br/>Piece-Square Table评估<br/>6种棋子位置价值表"]
        ClaudeProvider["<b>ClaudeApiProvider.cs</b><br/>Volces Ark HTTP调用<br/>UCI/SAN解析+回退<br/>TLS 1.2+ 强制启用"]
