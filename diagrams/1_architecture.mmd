        LBServer["<b>Node.js + Express + better-sqlite3</b><br/>Port 3000 · PM2守护<br/>POST /score 提交分数<br/>GET /leaderboard 查询排行<br/>PUT /player/:name 改名<br/>Joi参数校验 · Helmet安全头<br/>express-rate-limit 限流"]
        ChatServer["<b>WebSocket Chat Server</b><br/>Port 3001 · PM2守护<br/>ws库 · 房间隔离<br/>join/chat/leave 消息<br/>成员广播"]
        CloudAI["<b>Volces Ark API</b><br/>ark.cn-beijing.volces.com<br/>model: ark-code-latest<br/>→ MiniMax-M3 后端<br/>Anthropic Messages API"]
    end

